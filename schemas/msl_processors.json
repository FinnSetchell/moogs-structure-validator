{
  "moogs_structures:pillar_processor": {
    "type": "object",
    "required": ["processor_type", "pillar_trigger_and_replacements"],
    "properties": {
      "processor_type": { "type": "string" },
      "pillar_trigger_and_replacements": {
        "type": "array",
        "description": "Trigger block states and the pillar block state each one spawns.",
        "items": {
          "type": "object",
          "required": ["trigger", "replacement"],
          "properties": {
            "trigger":     { "$ref": "msl_blockstate.json" },
            "replacement": { "$ref": "msl_blockstate.json" }
          }
        }
      },
      "pillar_processor_list": {
        "type": "string",
        "description": "Processor list applied to each placed pillar block. Defaults to minecraft:empty.",
        "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
      },
      "direction": {
        "type": "string",
        "enum": ["down", "up", "north", "south", "west", "east"],
        "description": "Direction the pillar extends in. Defaults to down."
      },
      "original_replaced_block": { "$ref": "msl_blockstate.json" },
      "pillar_length": {
        "type": "integer",
        "description": "Maximum pillar length in blocks. Defaults to 1000."
      },
      "forced_placement": { "type": "boolean" },
      "pillar_state_randomizer": {
        "type": "object",
        "description": "Weighted block state randomizer with optional per-entry altitude bounds.",
        "required": ["default"],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["block", "probability"],
              "properties": {
                "block": { "$ref": "msl_blockstate.json" },
                "probability": { "type": "number", "minimum": 0, "maximum": 1 },
                "min_y": { "type": "integer" },
                "max_y": { "type": "integer" }
              }
            }
          },
          "default": { "$ref": "msl_blockstate.json" }
        }
      }
    }
  },

  "moogs_structures:spawner_randomizing_processor": {
    "type": "object",
    "required": ["processor_type", "weighted_entities"],
    "properties": {
      "processor_type": { "type": "string" },
      "weighted_entities": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["entity", "weight"],
          "properties": {
            "entity": {
              "type": "string",
              "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
            },
            "weight": { "type": "integer", "minimum": 1 },
            "nbt":    { "type": "object" }
          }
        }
      },
      "delay":                 { "type": "integer", "minimum": 0 },
      "max_nearby_entities":   { "type": "integer", "minimum": 0 },
      "max_spawn_delay":       { "type": "integer", "minimum": 0 },
      "min_spawn_delay":       { "type": "integer", "minimum": 0 },
      "required_player_range": { "type": "integer", "minimum": 0 },
      "spawn_count":           { "type": "integer", "minimum": 0 },
      "spawn_range":           { "type": "integer", "minimum": 0 },
      "spawner_replacement_block": { "$ref": "msl_blockstate.json" }
    }
  },

  "moogs_structures:trial_spawner_randomizing_processor": {
    "type": "object",
    "required": ["processor_type", "normal_config"],
    "properties": {
      "processor_type": { "type": "string" },
      "normal_config": {
        "type": "string",
        "description": "Resource location of a minecraft:trial_spawner config.",
        "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
      },
      "ominous_config": {
        "type": "string",
        "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
      }
    }
  },

  "moogs_structures:vault_randomizing_processor": {
    "type": "object",
    "required": ["processor_type", "loot_table"],
    "properties": {
      "processor_type": { "type": "string" },
      "loot_table": {
        "type": "string",
        "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
      },
      "ominous_loot_table": {
        "type": "string",
        "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
      },
      "key_item": {
        "type": "string",
        "description": "Item id of the key that opens the vault. Defaults to minecraft:trial_key.",
        "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
      },
      "ominous_key_item": {
        "type": "string",
        "description": "Defaults to minecraft:ominous_trial_key.",
        "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
      }
    }
  },

  "moogs_structures:equip_armor_stand_processor": {
    "type": "object",
    "required": ["processor_type", "armor_sets"],
    "properties": {
      "processor_type": { "type": "string" },
      "armor_sets": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["armor", "weight"],
          "properties": {
            "armor": {
              "type": "object",
              "description": "Item NBT per slot; all slots optional.",
              "properties": {
                "head":  { "type": "object" },
                "chest": { "type": "object" },
                "legs":  { "type": "object" },
                "feet":  { "type": "object" }
              }
            },
            "weight": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  },

  "moogs_structures:close_off_fluid_sources_processor": {
    "type": "object",
    "required": ["processor_type", "weighted_list_of_replacement_blocks"],
    "properties": {
      "processor_type": { "type": "string" },
      "weighted_list_of_replacement_blocks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["block", "weight"],
          "properties": {
            "block": {
              "type": "string",
              "description": "Block id (not a block state object).",
              "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
            },
            "weight": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "ignore_down":     { "type": "boolean" },
      "if_air_in_world": { "type": "boolean" }
    }
  },

  "moogs_structures:remove_floating_blocks_processor": {
    "type": "object",
    "required": ["processor_type"],
    "properties": {
      "processor_type": { "type": "string" }
    }
  },

  "moogs_structures:waterlogging_fix_processor": {
    "type": "object",
    "description": "1.20 line only (MSL branches 1.20-1.20.4 / 1.20.5-1.20.6); dropped at 1.21. CODEC is Codec.unit(WaterloggingFixProcessor::new) -- no fields at all.",
    "required": ["processor_type"],
    "properties": {
      "processor_type": { "type": "string" }
    }
  },

  "moogs_structures:super_gravity_processor": {
    "type": "object",
    "required": ["processor_type"],
    "properties": {
      "processor_type": { "type": "string" },
      "heightmap": {
        "type": "string",
        "enum": [
          "WORLD_SURFACE_WG",
          "WORLD_SURFACE",
          "OCEAN_FLOOR_WG",
          "OCEAN_FLOOR",
          "MOTION_BLOCKING",
          "MOTION_BLOCKING_NO_LEAVES"
        ],
        "description": "Heightmap the blocks fall onto. Defaults to WORLD_SURFACE_WG."
      },
      "offset": { "type": "integer" },
      "ignore_block": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
        }
      },
      "require_water_surface": { "type": "boolean" }
    }
  },

  "moogs_structures:flood_with_water_processor": {
    "type": "object",
    "required": ["processor_type", "flood_level"],
    "properties": {
      "processor_type": { "type": "string" },
      "flood_level": {
        "type": "integer",
        "description": "World Y level up to which the structure interior is flooded."
      }
    }
  },

  "moogs_structures:vanilla_loot_swap_processor": {
    "type": "object",
    "description": "MSL 3.1.0+. Swaps mod loot table refs on containers back to vanilla loot tables when the matching (modid, vanilla_key) preset is enabled.",
    "required": ["processor_type", "modid", "vanilla_key", "loot_table_mapping"],
    "properties": {
      "processor_type": { "type": "string" },
      "modid":          { "type": "string" },
      "vanilla_key":    { "type": "string" },
      "loot_table_mapping": {
        "type": "object",
        "description": "Map of FROM loot table id (used on the replacement's containers) -> TO vanilla loot table id.",
        "minProperties": 1,
        "patternProperties": {
          "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$": {
            "type": "string",
            "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
          }
        },
        "additionalProperties": false
      },
      "seed_strategy": {
        "type": "string",
        "description": "How the loot roll seed is handled. Any other value silently behaves as preserve.",
        "enum": ["preserve", "randomize", "clear"]
      }
    }
  },

  "moogs_structures:random_replace_with_properties_processor": {
    "type": "object",
    "required": ["processor_type", "input_block", "probability"],
    "properties": {
      "processor_type": { "type": "string" },
      "input_block": {
        "type": "string",
        "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
      },
      "output_block": {
        "type": "string",
        "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
      },
      "output_blocks": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
        }
      },
      "probability": { "type": "number", "minimum": 0, "maximum": 1 }
    }
  }
}
